# Copy to .env (gitignored) and fill in.
ANTHROPIC_API_KEY=

# Written by `python setup_skill.py`. Pin a version with RESUME_SKILL_VERSION;
# default is "latest".
RESUME_SKILL_ID=
# RESUME_SKILL_VERSION=latest

# Optional sources. Without these, only ATS boards run.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SERPAPI_KEY=

# Optional: read LinkedIn job-alert emails from your own inbox.
IMAP_USER=
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
